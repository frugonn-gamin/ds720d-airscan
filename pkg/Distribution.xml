<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Pont AirScan pour Brother DS-720D</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="local.ds720d.airscan"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="local.ds720d.airscan" visible="false">
        <pkg-ref id="local.ds720d.airscan"/>
    </choice>
    <pkg-ref id="local.ds720d.airscan" version="VERSION" onConclusion="none">ds720d-airscan-component.pkg</pkg-ref>
</installer-gui-script>
